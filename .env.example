# Reference only: Spring Boot does NOT load this file automatically.
# Set these in your terminal/IDE. Never commit real passwords.
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=lost_found
DB_USERNAME=lost_found_app
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Exact origins only; public HTTP and wildcards are rejected. Integration/trial profiles use their own fixed loopback origins.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
ADMIN_PASSWORD=
# Synthetic campus defaults. Real-campus use requires separate data and reviewed configuration.
CAMPUS_ID=TEST_CAMPUS
CAMPUS_TEST_MODE=true
# Integration profile: a separate database, Redis instance and test administrator.
TEST_DB_USERNAME=lost_found_test_app
TEST_DB_PASSWORD=
TEST_REDIS_USERNAME=
TEST_REDIS_PASSWORD=
TEST_ADMIN_PASSWORD=
# Private image roots are never static web directories. Test limits are not a production retention policy.
MEDIA_ROOT=.local/media-dev
TEST_MEDIA_ROOT=.local/media-test
MEDIA_CLEANUP_ENABLED=false
# Local-only AI. Remain disabled until resource/quality tests pass; no API key is used.
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:1.7b
