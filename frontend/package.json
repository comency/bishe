{
  "name": "campus-lost-found-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.18.0", "npm": ">=10 <12" },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "vite",
    "dev:integration": "vite --mode integration",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "verify": "npm run lint && npm run test:unit && npm run build"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
